/* Layout global Alfadime */

.alfadime-shell {
    display: flex;
    width: 100%;
    height: 100%;
    min-height: 0;
    overflow: hidden;
    background: #eef1f5;
}

.alfadime-sidebar {
    position: relative;
    display: flex;
    flex-direction: column;
    width: 218px;
    min-width: 218px;
    height: 100%;
    min-height: 0;
    overflow: hidden;
    border-right: 1px solid #d5dbe3;
    background: #ffffff;
    transition: width 0.18s ease, min-width 0.18s ease;
}

.alfadime-shell.sidebar-collapsed .alfadime-sidebar {
    width: 58px;
    min-width: 58px;
}

.alfadime-sidebar-toggle {
    position: absolute;
    top: 10px;
    right: 6px;
    z-index: 5;
    display: grid;
    width: 24px;
    height: 24px;
    place-items: center;
    border: 1px solid #cdd6df;
    border-radius: 5px;
    background: #ffffff;
    color: #45515e;
    cursor: pointer;
    font-size: 12px;
    line-height: 1;
}

.alfadime-sidebar-toggle:hover {
    border-color: #3b5f86;
    background: #f0f4f8;
    color: #344b65;
}

.alfadime-navigation {
    display: flex;
    flex: 1;
    min-height: 0;
    flex-direction: column;
    gap: 3px;
    padding: 42px 10px 12px;
    overflow-x: hidden;
    overflow-y: auto;
}

.alfadime-navigation-title {
    flex-shrink: 0;
    margin: 0 9px 8px;
    color: #8a96a3;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
}

.alfadime-menu-item {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: 9px;
    width: 100%;
    min-height: 35px;
    border: 0;
    border-radius: 6px;
    padding: 0 10px;
    background: transparent;
    color: #5e6b79;
    cursor: pointer;
    font-family: inherit;
    font-size: 14px;
    text-align: left;
    transition: background 0.15s ease, color 0.15s ease;
}

.alfadime-menu-item:hover {
    background: #f0f4f8;
    color: #344b65;
}

.alfadime-menu-item.active {
    background: #e7edf4;
    color: #344f6c;
    font-weight: 700;
}

.alfadime-menu-icon {
    display: grid;
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    place-items: center;
    border-radius: 4px;
    background: #f0f3f6;
    color: #60758c;
    font-size: 13px;
}

.alfadime-menu-item.active .alfadime-menu-icon {
    background: #d1dce8;
    color: #344f6c;
}

.alfadime-menu-subitems {
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding: 4px 0 4px 24px;
}

.alfadime-menu-subitems .alfadime-menu-item {
    min-height: 30px;
    font-size: 12px;
}

.alfadime-sidebar-footer {
    display: flex;
    flex-shrink: 0;
    flex-direction: column;
    gap: 10px;
    min-height: 94px;
    box-sizing: border-box;
    border-top: 1px solid #e1e6ed;
    padding: 10px 15px;
    color: #7a8795;
    font-size: 10px;
}

.alfadime-sidebar-user {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 2px;
}

.alfadime-sidebar-user-label {
    color: #8a96a3;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
}

.alfadime-sidebar-user-name {
    overflow: hidden;
    color: #45515e;
    font-size: 12px;
    font-weight: 600;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.alfadime-sidebar-footer-actions {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
}

.alfadime-sidebar-footer-actions small {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    color: #a0aab5;
    font-size: 9px;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.alfadime-settings-button {
    display: grid;
    flex-shrink: 0;
    width: 30px;
    height: 30px;
    place-items: center;
    border: 1px solid #cdd6df;
    border-radius: 6px;
    background: #ffffff;
    color: #45515e;
    cursor: pointer;
    font-size: 15px;
    line-height: 1;
}

.alfadime-settings-button:hover {
    border-color: #3b5f86;
    background: #f0f4f8;
    color: #344b65;
}

.alfadime-settings-button.active {
    border-color: #3b5f86;
    background: #e7edf4;
    color: #344f6c;
}

.alfadime-sidebar-footer .alfadime-logout-button {
    flex-shrink: 0;
    min-height: 30px;
    border: 1px solid #cdd6df;
    border-radius: 6px;
    padding: 0 9px;
    background: #ffffff;
    color: #45515e;
    cursor: pointer;
    font-family: inherit;
    font-size: 11px;
}

.alfadime-sidebar-footer .alfadime-logout-button:hover {
    border-color: #aab7c5;
    background: #f0f4f8;
    color: #344b65;
}

.alfadime-content {
    display: flex;
    flex: 1;
    min-width: 0;
    min-height: 0;
    flex-direction: column;
    overflow: hidden;
}

.alfadime-main {
    flex: 1;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
}

.alfadime-main > * {
    min-width: 0;
    min-height: 0;
}

/* Padrão global de módulos */

.app-module {
    display: flex;
    width: 100%;
    height: 100%;
    min-height: 0;
    box-sizing: border-box;
    flex-direction: column;
    overflow: hidden;
    background: #eef1f5;
    color: #263241;
}

.app-module-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    flex-shrink: 0;
    width: 100%;
    box-sizing: border-box;
    padding: 16px clamp(14px, 2vw, 24px) 10px;
}

.app-module-header h1 {
    margin: 0;
    color: #263241;
    font-size: clamp(20px, 1.7vw, 26px);
    font-weight: 700;
    line-height: 1.2;
}

.app-module-body {
    display: flex;
    flex: 1;
    min-width: 0;
    min-height: 0;
    gap: 12px;
    box-sizing: border-box;
    padding: 0 clamp(14px, 2vw, 24px) 18px;
}

.app-module-sidebar {
    display: flex;
    flex-shrink: 0;
    flex-direction: column;
    width: 280px;
    min-width: 280px;
    max-height: 100%;
    box-sizing: border-box;
    overflow: hidden;
    border: 1px solid #d5dbe3;
    border-radius: 8px;
    background: #ffffff;
    box-shadow: 0 1px 3px rgb(31 41 55 / 5%);
}

.app-module-sidebar-section {
    box-sizing: border-box;
    border-bottom: 1px solid #e6ebf2;
    padding: 12px;
}

.app-module-sidebar-section:last-child {
    border-bottom: 0;
}

.app-module-sidebar-title {
    margin: 0 0 9px;
    color: #263241;
    font-size: 12px;
    font-weight: 700;
}

.app-module-main {
    display: flex;
    flex: 1;
    min-width: 0;
    min-height: 0;
    flex-direction: column;
    overflow: hidden;
}

.app-table-panel {
    display: flex;
    flex: 1;
    min-width: 0;
    min-height: 0;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid #d5dbe3;
    border-radius: 8px;
    background: #ffffff;
    box-shadow: 0 1px 3px rgb(31 41 55 / 5%);
}

.app-table-wrapper {
    flex: 1;
    width: 100%;
    min-width: 0;
    min-height: 0;
    overflow-x: hidden;
    overflow-y: auto;
}

.app-table {
    width: 100%;
    min-width: 0;
    border-collapse: collapse;
    table-layout: auto;
    font-size: 10px;
}

.app-table th,
.app-table td {
    box-sizing: border-box;
    border-top: 1px solid #e1e6ed;
    padding: 7px 6px;
    text-align: left;
    vertical-align: middle;
    white-space: normal;
    word-break: break-word;
}

.app-table th {
    position: sticky;
    top: 0;
    z-index: 2;
    background: #f5f8fb;
    color: #6b7785;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
}

.app-table td {
    color: #45515e;
}

.app-table tbody tr:hover {
    background: #f8fafc;
}

.app-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 8px;
}

.app-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    min-height: 33px;
    box-sizing: border-box;
    border: 1px solid #b9cbdc;
    border-radius: 5px;
    padding: 0 12px;
    background: #edf4fa;
    color: #345d82;
    cursor: pointer;
    font-family: inherit;
    font-size: 11px;
    font-weight: 700;
    transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease;
}

.app-button:hover:not(:disabled) {
    border-color: #3b5f86;
    background: #dfeaf4;
    color: #304e6e;
}

.app-button.primary {
    border-color: #3b5f86;
    background: #3b5f86;
    color: #ffffff;
}

.app-button.primary:hover:not(:disabled) {
    border-color: #304e6e;
    background: #304e6e;
}

.app-button:disabled {
    cursor: not-allowed;
    opacity: 0.55;
}

.app-field {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
}

.app-field > span {
    color: #56616d;
    font-size: 10px;
    font-weight: 700;
}

.app-field input,
.app-field select {
    width: 100%;
    min-height: 32px;
    box-sizing: border-box;
    border: 1px solid #cdd6df;
    border-radius: 5px;
    padding: 0 8px;
    background: #ffffff;
    color: #263241;
    font-family: inherit;
    font-size: 11px;
    outline: none;
}

.app-field input:focus,
.app-field select:focus {
    border-color: #3b5f86;
    box-shadow: 0 0 0 2px rgb(59 95 134 / 10%);
}

@media (max-width: 1100px) {
    .app-module-body {
        flex-direction: column;
    }

    .app-module-sidebar {
        width: 100%;
        min-width: 0;
        max-height: 42vh;
        overflow-y: auto;
    }
}

.alfadime-loading-screen {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    color: #4b5563;
    background: #f9fafb;
}

@media (max-width: 900px) {
    .alfadime-shell:not(.sidebar-collapsed) .alfadime-sidebar {
        width: 185px;
        min-width: 185px;
    }

    .alfadime-menu-item {
        font-size: 10px;
    }
}

@media (max-width: 680px) {
    .alfadime-shell:not(.sidebar-collapsed) .alfadime-sidebar {
        width: 168px;
        min-width: 168px;
    }

    .alfadime-navigation {
        padding-right: 7px;
        padding-left: 7px;
    }

    .alfadime-menu-item {
        gap: 6px;
        padding: 0 7px;
        font-size: 9px;
    }

    .alfadime-menu-icon {
        width: 18px;
        height: 18px;
        font-size: 11px;
    }

    .alfadime-sidebar-footer {
        padding-right: 9px;
        padding-left: 9px;
    }

    .alfadime-sidebar-footer-actions {
        gap: 5px;
    }

    .alfadime-sidebar-footer .alfadime-logout-button {
        padding-right: 6px;
        padding-left: 6px;
        font-size: 10px;
    }
}
